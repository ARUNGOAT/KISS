    <script>
        // Create floating particles
        for(let i = 0; i < 30; i++) {
            const particle = document.createElement('div');
            particle.className = 'particle';
            particle.style.left = Math.random() * 100 + '%';
            particle.style.top = Math.random() * 100 + '%';
            particle.style.animationDelay = Math.random() * 10 + 's';
            document.body.appendChild(particle);
        }

        function goBack() {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById('choiceScreen').classList.add('active');
        }

        function startRadar() {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById('radarScreen').classList.add('active');
            
            // Animate radar
            setTimeout(() => {
                document.querySelector('.target').style.opacity = '1';
                document.querySelector('.target').style.animation = 'fadeIn 1s ease';
            }, 500);
            
            setTimeout(() => {
                document.querySelector('.signal').style.opacity = '1';
                animateSignalToTarget();
            }, 1500);
        }

        function animateSignalToTarget() {
            const signal = document.querySelector('.signal');
            const target = document.querySelector('.target');
            
            // Send signal
            signal.style.transition = 'all 2s ease-in-out';
            signal.style.bottom = '70%';
            signal.style.left = '80%';
            
            setTimeout(() => {
                // Return signal
                signal.style.bottom = '20%';
                signal.style.left = '50%';
                signal.style.background = '#4ade80';
                
                setTimeout(() => {
                    document.getElementById('radarMessage').textContent = 'Signal Received! 💕 You are my target, my destination, my everything!';
                    document.getElementById('radarMessage').style.animationDelay = '0s';
                }, 2000);
            }, 2000);
        }

        function startCCN() {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById('ccnScreen').classList.add('active');
            
            // First message attempt
            setTimeout(() => {
                const packet1 = document.getElementById('packet1');
                packet1.style.opacity = '1';
                packet1.style.animation = 'packetMove 3s ease-in-out forwards';
                
                document.getElementById('arunScreen').textContent = 'Sending...';
            }, 1000);
            
            // Show rejection
            setTimeout(() => {
                document.getElementById('rejection').style.display = 'block';
                document.getElementById('dikshaScreen').textContent = 'Busy...';
                document.getElementById('arunScreen').textContent = 'No ACK 😔';
            }, 4000);
            
            // Second attempt
            setTimeout(() => {
                document.getElementById('rejection').style.display = 'none';
                const packet2 = document.getElementById('packet2');
                packet2.style.opacity = '1';
                packet2.style.animation = 'packetMove 3s ease-in-out forwards';
                
                document.getElementById('arunScreen').textContent = 'Retrying...';
            }, 5500);
            
            // Show acknowledgment
            setTimeout(() => {
                document.getElementById('ack').style.opacity = '1';
                document.getElementById('ack').style.animation = 'finalReveal 1s ease forwards';
                document.getElementById('dikshaScreen').textContent = 'Received! 💕';
                document.getElementById('arunScreen').textContent = 'ACK! 😊';
            }, 8500);
            
            // Final message
            setTimeout(() => {
                document.getElementById('ccnMessage').textContent = 'I LOVE YOU BUBU! 💕';
                document.getElementById('ccnMessage').style.animationDelay = '0s';
            }, 10000);
        }
    </script>
</body>
</html>
