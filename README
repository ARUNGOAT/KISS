                <div class="choice-card" onclick="startCCN()">
                    <div class="choice-icon">💻</div>
                    <div class="choice-name">CCN</div>
                    <div class="choice-desc">Like a computer network, my message might fail first, but I'll keep trying until you accept my love</div>
                </div>
            </div>
        </div>

        <!-- Radar Screen -->
        <div class="screen" id="radarScreen">
